# Docker + existing PostgreSQL: cp .env.external.example .env
# Then: docker compose -f docker-compose.external.yml up -d --build --wait
# Use an address reachable FROM THE CONTAINER; localhost is the container itself.
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/jdbc_test
SPRING_DATASOURCE_USERNAME=jdbc_test
# Required. Single quotes preserve literal $ and # in Compose .env values.
SPRING_DATASOURCE_PASSWORD=''
# Required: openssl rand -base64 32. Preserve across restarts/restores.
JDBC_TEST_MASTER_KEY=
JDBC_TEST_PORT=8080
JDBC_TEST_BIND_ADDRESS=127.0.0.1
JDBC_TEST_MAX_CONCURRENT_RUNS=1
JDBC_TEST_RUN_TIMEOUT=30m
JAVA_TOOL_OPTIONS=
